# Copy this file to .env for local runs, or paste these into Railway's
# service "Variables" tab for deployment. See README.md for where each value comes from.

# --- Anthropic (README Step 1) ---
ANTHROPIC_API_KEY=
CLARA_MODEL=claude-sonnet-5

# --- Twilio / SMS (README Step 2) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1XXXXXXXXXX
MY_PHONE_NUMBER=+1XXXXXXXXXX

# --- Google Calendar, read-only (README Step 3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Notion (README Step 4) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_TITLE_PROP=Name
NOTION_STATUS_PROP=Status
NOTION_DUE_DATE_PROP=Due Date
NOTION_STATUS_TYPE=status
NOTION_NOT_DONE_VALUE=Not started
NOTION_DONE_VALUE=Done

# --- Database ---
# Leave unset on Railway if you add the Postgres plugin -- it sets DATABASE_URL automatically.
DATABASE_URL=sqlite:///./clara.db

# --- Misc ---
TIMEZONE=America/New_York
